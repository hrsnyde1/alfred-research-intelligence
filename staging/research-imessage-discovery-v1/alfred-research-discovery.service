[Unit]
Description=One-time Research iMessage identity discovery
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=alfredresearchphoton
Group=alfredresearchphoton
UMask=0077
StateDirectory=alfred-research-discovery
StateDirectoryMode=0700
LoadCredential=research-project-id:/etc/alfred-research-photon/credentials/research-project-id
LoadCredential=research-project-secret:/etc/alfred-research-photon/credentials/research-project-secret
WorkingDirectory=/opt/alfred-research-discovery/v1
ExecStart=/usr/bin/flock -n /var/lib/alfredresearch-photon/connector.lock /opt/alfred-research-photon/runtime/bin/node /opt/alfred-research-discovery/v1/main.mjs --live-discovery /etc/alfred-research-discovery/policy.json
Restart=no
TimeoutStartSec=125
TimeoutStopSec=3
KillMode=control-group
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
BindReadOnlyPaths=/home/alfred/.hermes/tools/node-26.7.0-linux-x64:/opt/alfred-research-photon/runtime
BindReadOnlyPaths=/home/alfred/.hermes/hermes-agent/plugins/platforms/photon/sidecar/node_modules:/opt/alfred-research-discovery/v1/node_modules
ReadWritePaths=/var/lib/alfred-research-discovery /var/lib/alfredresearch-photon
MemoryMax=1G
CPUQuota=50%
TasksMax=64
LimitNOFILE=256
